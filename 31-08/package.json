{
  "name": "tareas-api",
  "version": "2.0.0",
  "description": "API REST para gestión de tareas, usuarios y proyectos",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "dev:ts": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cucumber-js --require-module ts-node/register --require 'src/tests/steps/**/*.ts' src/tests/features/**/*.feature"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "sqlite": "^5.1.1",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/helmet": "^7.0.0",
    "@types/uuid": "^9.0.3",
    "@types/node": "^20.5.0",
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^29.5.3",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "@cucumber/cucumber": "^9.5.1",
    "supertest": "^6.3.3"
  }
}
